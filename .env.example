# 複製此檔為 .env 並填入實際值
JWT_SECRET=請替換為隨機字串
PORT=3000
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Railway 持久磁碟路徑（部署時設定）
DB_PATH=/data/leica.db

# 網站入口 Google Workspace 驗證（未填妥時全站拒絕存取）
SITE_ORIGIN=https://your-domain.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=genmall.com.tw
# 與 JWT_SECRET 分開，至少 32 bytes 的隨機密鑰
SITE_SESSION_SECRET=
